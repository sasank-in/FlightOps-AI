# Template only: copy to .env and fill in real values there. Never put real secrets in this file
# (it is committed and the repository is public). .env is git-ignored.

# Optional: override the detected project root (absolute path).
# FLIGHTOPS_PROJECT_ROOT=

# AI engineering assistant (Phase 7). LLM_PROVIDER=none (or no key) uses the deterministic report template.
LLM_PROVIDER=groq
LLM_API_KEY=your-groq-api-key
# Optional: any OpenAI-compatible chat-completions endpoint and model
# FLIGHTOPS_LLM_BASE_URL=https://api.groq.com/openai/v1
# FLIGHTOPS_LLM_MODEL=openai/gpt-oss-120b
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/flightops

# Application backend (Phase 5)
# At least 32 random bytes, e.g. PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
FLIGHTOPS_JWT_SECRET=change-me-to-at-least-32-random-bytes
FLIGHTOPS_ADMIN_USERNAME=admin
# First admin, created only when the users table is empty; at least 12 characters
FLIGHTOPS_ADMIN_PASSWORD=change-me-12-chars-minimum
# FLIGHTOPS_INFERENCE_URL=http://127.0.0.1:8000
# FLIGHTOPS_BACKEND_PORT=8080
